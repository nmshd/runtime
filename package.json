{
    "name": "monorepo",
    "private": true,
    "description": "The enmeshed Monorepo.",
    "homepage": "https://enmeshed.eu",
    "license": "AGPL-3.0-or-later",
    "author": "j&s-soft AG",
    "workspaces": [
        "packages/core-types",
        "packages/transport",
        "packages/content",
        "packages/consumption",
        "packages/runtime-types",
        "packages/runtime",
        "packages/app-runtime"
    ],
    "scripts": {
        "build:node": "tsc --build",
        "build:watch": "tsc --build -w",
        "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
        "lint:eslint": "eslint",
        "lint:prettier": "prettier --check .",
        "lint:tsc": "npm run --workspaces lint:tsc",
        "outdated": "ncu -i && ncu -i --workspaces",
        "start:backbone": "docker compose -f .dev/compose.backbone.yml up -d --wait",
        "teardown:backbone": "docker compose -f .dev/compose.backbone.yml down -v",
        "teardown:openid4vc": "docker rm -f eudiplo",
        "test:teardown": "docker compose -f .dev/compose.yml down -fsv"
    },
    "devDependencies": {
        "@js-soft/eslint-config-ts": "2.0.13",
        "@js-soft/license-check": "1.0.16",
        "@types/node": "26.6.5",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/eslint-plugin": "^1.6.28",
        "dependency-cruiser": "18.7.0",
        "enhanced-publish": "1.1.18",
        "eslint": "10.13.0",
        "npm-check-updates": "23.1.1",
        "prettier": "3.9.10",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vitest": "^5.0.5"
    }
}
