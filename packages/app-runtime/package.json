{
    "name": "@nmshd/app-runtime",
    "description": "The App Runtime",
    "homepage": "https://enmeshed.eu",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nmshd/runtime.git",
        "directory": "packages/app-runtime"
    },
    "license": "AGPL-3.0-or-later",
    "author": "j&s-soft AG",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm run build:node",
        "build:ci": "npm run build:node && ../../.ci/writeBuildInformation.sh",
        "build:node": "tsc -p tsconfig.json",
        "build:notest": "npm run build:node",
        "cdep": "tsc && depcruise --config ../../.dependency-cruiser.cjs dist",
        "lint:tsc": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
        "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --forceExit",
        "test:ci": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest -i --forceExit --coverage"
    },
    "jest": {
        "collectCoverageFrom": [
            "./src/**"
        ],
        "coverageProvider": "v8",
        "coverageReporters": [
            "text-summary",
            "cobertura",
            "lcov"
        ],
        "maxWorkers": 5,
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "setupFilesAfterEnv": [
            "./test/customMatchers.ts",
            "jest-expect-message",
            "../../jest.setup.cjs"
        ],
        "testEnvironment": "node",
        "testTimeout": 60000,
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "tsconfig": "test/tsconfig.json",
                    "useESM": true
                }
            ]
        },
        "moduleNameMapper": {
            "^@verifiables/request-converter$": "<rootDir>/../../node_modules/@verifiables/request-converter/dist/index.js",
            "^webcrypto-core$": "<rootDir>/../../node_modules/webcrypto-core/build/webcrypto-core.js"
        },
        "transformIgnorePatterns": [
            "[/\\\\]packages[/\\\\][^/\\\\]+[/\\\\]dist[/\\\\]",
            "<rootDir>/node_modules/(?!(@noble|@stablelib|@credo\\-ts|@verifiables)/)"
        ]
    },
    "dependencies": {
        "@js-soft/docdb-access-loki": "^1.4.2",
        "@js-soft/logging-abstractions": "^1.2.5",
        "@nmshd/runtime": "*",
        "eventsource": "^5.0.0",
        "lodash": "^4.18.1"
    },
    "devDependencies": {
        "@eudiplo/sdk-core": "7.2.0",
        "@js-soft/node-logger": "1.2.10",
        "@types/lodash": "4.17.25",
        "@types/lokijs": "1.5.14",
        "@types/luxon": "3.7.4"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
