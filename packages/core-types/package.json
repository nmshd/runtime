{
    "name": "@nmshd/core-types",
    "description": "The enmeshed core types.",
    "homepage": "https://enmeshed.eu",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nmshd/runtime.git",
        "directory": "packages/runtime"
    },
    "license": "AGPL-3.0-or-later",
    "author": "j&s-soft AG",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "build:ci": "tsc",
        "cdep": "tsc && depcruise --config ../../.dependency-cruiser.cjs dist",
        "lint:tsc": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
        "test": "npm run test:compile && vitest run --maxWorkers=1",
        "test:ci": "npm run test:compile && vitest run --coverage --maxWorkers=1",
        "test:compile": "tsc -p test/tsconfig.vitest.json"
    },
    "dependencies": {
        "@js-soft/logging-abstractions": "^1.2.5",
        "@js-soft/ts-serval": "2.0.17",
        "@nmshd/crypto": "3.0.13",
        "json-stringify-safe": "^5.0.1",
        "luxon": "^3.7.2"
    },
    "devDependencies": {
        "@types/luxon": "3.7.6"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
