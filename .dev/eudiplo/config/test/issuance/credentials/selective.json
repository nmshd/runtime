{
    "$schema": "https://eudiplo.dev/schemas/v1/CredentialConfigFile.schema.json",
    "metadata": { "generation": 1 },
    "spec": {
        "id": "selective",
        "config": { "format": "dc+sd-jwt", "display": [{ "name": "Selective disclosure credential", "locale": "en-US" }] },
        "vct": "https://example.com/credentials/selective",
        "keyBinding": true,
        "fields": [
            { "path": ["given_name"], "type": "string", "defaultValue": "Alice", "mandatory": true, "disclosable": true },
            { "path": ["family_name"], "type": "string", "defaultValue": "Example", "mandatory": true, "disclosable": true }
        ]
    }
}
